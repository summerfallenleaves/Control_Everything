# Control_Everything - model configuration
# Variables are named by PURPOSE, not by model name,
# so swapping models never touches code.

# --- Decision model: picks the next action every step (REQUIRED brain) ---
DECISION_MODEL=claude-sonnet-4-5

# --- Planning model: task decomposition into sub-goals (reserved) ---
PLANNING_MODEL=claude-sonnet-4-5

# --- Vision model: screenshot understanding fallback (reserved) ---
# e.g. UI-TARS / Qwen2.5-VL when running locally
VISION_MODEL=

# --- API keys ---
ANTHROPIC_API_KEY=
