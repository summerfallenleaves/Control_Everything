# Control_Everything - model configuration
# 模板：复制为 .env 并填入 API key（与 .env 字段/注释保持一致）。
# Full per-purpose provider configs. See docs/model-recommendations.md
# for recommended setups (DeepSeek / Qwen / OpenRouter).

# --- DECISION: picks the next action every step (REQUIRED brain) ---
# Plan A: DeepSeek V4-Flash direct (cheap + reliable tool calling)
DECISION_PROVIDER=deepseek
DECISION_MODEL=deepseek-v4-pro
DECISION_API_KEY=
DECISION_BASE_URL=https://api.deepseek.com
# {PURPOSE}_THINKING - DeepSeek 类端点的思考模式开关
#   （仅对支持 thinking 参数的 OpenAI 兼容端点有效；OpenAI 官方 / Qwen 等
#    不识别此参数，请留空不设置。我们的客户端只在配置了 THINKING 时才发送。）
#
#   允许取值：
#     enabled  - 启用思考模式：推理更强，但更慢、更贵、消耗更多 token；
#                ⚠️ DeepSeek 思考模式【不支持强制 tool_choice】，
#                会报 "Thinking mode does not support this tool_choice" (400)
#     disabled - 关闭思考模式：快速、稳定、便宜，适合 agent 实时决策循环（推荐）
#     auto     - 由模型/端点自动决定；DeepSeek 下可能进入思考模式，
#                同样可能触发上述 tool_choice 限制
#     留空     - 不发送 thinking 参数，使用端点默认行为；
#                ⚠️ DeepSeek 默认即思考模式，强制 tool_choice 会报错，
#                因此 DeepSeek 必须显式配置（建议 disabled）
DECISION_THINKING=disabled
# {PURPOSE}_THINKING_EFFORT - 思考程度（仅 THINKING=enabled/auto 时生效；disabled 时忽略）
#   允许取值：minimal | low | medium | high | max
#   各端点映射：OpenAI 原样传 reasoning_effort（max→high）；DeepSeek 原样支持
#     low/high/max（minimal/low→low，medium/high→high，max→max）；
#     Anthropic 映射为 budget_tokens（minimal=1024 ... max=16384）
DECISION_THINKING_EFFORT=max

# --- PLANNING: task decomposition (reserved) ---
PLANNING_PROVIDER=deepseek
PLANNING_MODEL=deepseek-v4-pro
PLANNING_API_KEY=
PLANNING_BASE_URL=https://api.deepseek.com
# (取值说明见上方 DECISION_THINKING 注释)
PLANNING_THINKING=disabled
PLANNING_THINKING_EFFORT=max

# --- VISION: screenshot understanding fallback (reserved) ---
# VISION_INTERVAL - vision analysis every N steps (default 3); the step after
#   a screen-changing action (tap/type/key/open_app...) always re-analyzes.
VISION_INTERVAL=3
VISION_PROVIDER=qwen
VISION_MODEL=qwen3.7-plus
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Legacy fallback key (optional; per-purpose keys win) ---
ANTHROPIC_API_KEY=

# ===== 以下为模板补充参考信息（.env 中可忽略）=====
#
# NOTE: DeepSeek official API is TEXT-ONLY (no image input). For vision,
# use Qwen3.6/3.7 multimodal (qwen3.7-plus / qwen3.7-flash) - they also
# support Function Calling + structured output.
#
# Vendor quick reference (any of these as {PURPOSE}_PROVIDER):
#   openrouter    -> https://openrouter.ai/api/v1            (route many models, one key)
#   deepseek      -> https://api.deepseek.com                (deepseek-v4-flash / deepseek-v4-pro;
#                      deepseek-chat / deepseek-reasoner RETIRED 2026-07-24)
#   qwen/dashscope-> https://dashscope.aliyuncs.com/compatible-mode/v1  (qwen3.7-plus / qwen3.7-flash)
#   glm/zhipu     -> https://open.bigmodel.cn/api/paas/v4    (glm-4-plus / glm-4v)
#   kimi/moonshot -> https://api.moonshot.cn/v1              (kimi-k2 / moonshot-v1-8k)
#   ollama        -> http://localhost:11434/v1               (local, any key)
#
# Example - OpenRouter as the decision brain:
#   DECISION_PROVIDER=openrouter
#   DECISION_BASE_URL=https://openrouter.ai/api/v1
#   DECISION_API_KEY=sk-or-...
#   DECISION_MODEL=anthropic/claude-sonnet-4-5
