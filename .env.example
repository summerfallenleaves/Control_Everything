# Control_Everything - model configuration
# Each purpose (decision/planning/vision) is a FULL provider config:
#   {PURPOSE}_PROVIDER  anthropic | openai (openai covers OpenAI-compatible
#                        endpoints: DeepSeek, Moonshot, Qwen, Ollama, vLLM...)
#   {PURPOSE}_BASE_URL  API endpoint (leave empty for provider default)
#   {PURPOSE}_API_KEY   authentication key
#   {PURPOSE}_MODEL     model identifier

# --- DECISION: picks the next action every step (REQUIRED brain) ---
DECISION_PROVIDER=anthropic
DECISION_MODEL=claude-sonnet-4-5
DECISION_API_KEY=
DECISION_BASE_URL=

# --- PLANNING: task decomposition into sub-goals (reserved) ---
PLANNING_PROVIDER=anthropic
PLANNING_MODEL=claude-sonnet-4-5
PLANNING_API_KEY=
PLANNING_BASE_URL=

# --- VISION: screenshot understanding fallback (reserved) ---
# e.g. local Qwen2.5-VL via Ollama:
#   VISION_PROVIDER=openai
#   VISION_BASE_URL=http://localhost:11434/v1
VISION_MODEL=qwen3.7-plus
VISION_PROVIDER=openai
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=

# {PURPOSE}_THINKING - DeepSeek-style thinking mode (OpenAI-compatible endpoints only):
#   enabled  - thinking ON (slower/costlier; DeepSeek thinking mode REJECTS forced
#              tool_choice with a 400 error)
#   disabled - thinking OFF (fast/stable, recommended for agent loops)
#   auto     - model decides (may hit the same tool_choice limit on DeepSeek)
#   (empty)  - param not sent, endpoint default; DeepSeek defaults to thinking,
#              so forced tool_choice fails -> configure explicitly (recommend disabled)

# {PURPOSE}_THINKING_EFFORT - thinking depth (only when THINKING=enabled/auto;
#   ignored when disabled):
#   minimal | low | medium | high
#   Mapping: OpenAI -> reasoning_effort as-is; DeepSeek accepts low/high/max
#     (minimal/low -> low, medium/high -> high); Anthropic -> budget_tokens.
#   DeepSeek defaults thinking ON with effort=high - set THINKING=disabled for
#   fast agent loops, or enable + pick an effort for stronger reasoning.
#   OpenAI official / Qwen etc. do not understand this param - leave unset.
#
# NOTE: DeepSeek official API is TEXT-ONLY (no image input). For vision,
# use Qwen3.6/3.7 multimodal (qwen3.7-plus / qwen3.7-flash) - they also
# support Function Calling + structured output.

# --- Vendor quick reference (any of these as {PURPOSE}_PROVIDER) ---
# openrouter    -> https://openrouter.ai/api/v1            (route many models, one key)
# NOTE: deepseek-chat / deepseek-reasoner RETIRED 2026-07-24 - use deepseek-v4-*
# deepseek      -> https://api.deepseek.com                (deepseek-chat / deepseek-reasoner)
# qwen/dashscope-> https://dashscope.aliyuncs.com/compatible-mode/v1  (qwen-plus / qwen2.5-vl)
# glm/zhipu     -> https://open.bigmodel.cn/api/paas/v4    (glm-4-plus / glm-4v)
# kimi/moonshot -> https://api.moonshot.cn/v1              (kimi-k2 / moonshot-v1-8k)
# ollama        -> http://localhost:11434/v1               (local, any key)
#
# Example - OpenRouter as the decision brain:
#   DECISION_PROVIDER=openrouter
#   DECISION_BASE_URL=https://openrouter.ai/api/v1
#   DECISION_API_KEY=sk-or-...
#   DECISION_MODEL=anthropic/claude-sonnet-4-5

# --- Legacy fallback key (optional; DECISION_API_KEY wins) ---
ANTHROPIC_API_KEY=